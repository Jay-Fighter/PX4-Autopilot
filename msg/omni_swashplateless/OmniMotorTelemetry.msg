#  * ================= 电机反馈数据帧格式 =================
#  *
#  * 每帧长度：2 + 1 + 4 + 4 + 4 + 4 + 4 + 1 + 2 = 26 字节
#  * 所有多字节字段均为高位在前（Big-Endian）
#  *
#  * ┌────┬────────────┬────────┬────────────────┬──────────────────────────────────────────────┐
#  * │ 序号 │ 字段名         │ 字节数 │ 数据类型           │ 说明                                             │
#  * ├────┼────────────┼────────┼────────────────┼──────────────────────────────────────────────┤
#  * │  1  │ 起始码         │ 2 Hex  │ 固定值             │ 固定为 0xABCD，数据包起始标识，高位在前              │
#  * │  2  │ 电机序号       │ 1 Hex  │ 整数               │ 电机编号（1、2、3、4）                            │
#  * │  3  │ 电机位置       │ 4 Hex  │ float32 (rad)      │ 电机角位置，单位 rad (0~2π)，IEEE754 格式          │
#  * │  4  │ 电机速度       │ 4 Hex  │ float32 (rpm)      │ 电机转速，单位 rpm，每分钟转速，IEEE754 格式        │
#  * │  5  │ ua            │ 4 Hex  │ uint32              │ 高位在前，类型 uint32，用于调制指令平均分量          │
#  * │  6  │ us            │ 4 Hex  │ uint32              │ 高位在前，类型 uint32，用于调制指令正弦分量          │
#  * │  7  │ u             │ 4 Hex  │ uint32              │ 高位在前，类型 uint32，实际输出控制量               │
#  * │  8  │ 校验码         │ 1 Hex  │ 累加校验           │ 从起始码到校验码前一字节累加求和，取低 8 位          │
#  * │  9  │ 结束符         │ 2 Hex  │ 固定值             │ 固定为 0x0D0A，数据包结束标识，高位在前              │
#  * └────┴────────────┴────────┴────────────────┴──────────────────────────────────────────────┘
#  *
uint64 timestamp # 当前时间戳

uint8 	index
float32 obs_angle_rad
float32 obs_angle_deg
float32 obs_rpm
float32 throttle_ua
float32 throttle_us
float32 throttle_u

